#!/bin/sh /etc/rc.common

START=93
USE_PROCD=1

get_config() {
	config_get_bool enabled "$1" enabled 0
	config_get data_dir "$1" data_dir ""
	config_get_bool use_mise_home "$1" use_mise_home 0
	config_get host "$1" host "0.0.0.0"
	config_get port "$1" port "9000"
}

set_mise_env() {
	procd_set_param env \
		"$@" \
		HOME="$data_dir/global" \
		PATH="$data_dir/global/.local/share/mise/shims:$PATH"
}

prepare_agentflow_home() {
	if [ "$use_mise_home" = 1 ]; then
		[ -r /lib/functions/mise.sh ] || return 1
		. /lib/functions/mise.sh
		istore_runtime_env
		return $?
	fi

	mkdir -p "$data_dir/global"
}

set_agentflow_env() {
	if [ "$use_mise_home" = 1 ]; then
		procd_set_param env \
			"$@" \
			HOME="$HOME" \
			PATH="$PATH"
		return
	fi

	set_mise_env "$@"
}

start_service() {
	config_load agentflow
	config_foreach get_config agentflow
	[ "$enabled" = 1 ] || return 1

	[ -x /usr/sbin/agentflow ] || {
		logger -t agentflow "missing executable: /usr/sbin/agentflow"
		return 1
	}
	mkdir -p "$data_dir" "$data_dir/data" || return 1
	if ! prepare_agentflow_home; then
		logger -t agentflow "failed to prepare HOME environment"
		return 1
	fi

	logger -t agentflow "starting AgentFlow on $host:$port"
	procd_open_instance
	procd_set_param command /usr/sbin/agentflow
	set_agentflow_env \
		"AGENT_FLOW_DATA=$data_dir/data" \
		"AGENT_FLOW_HOST=$host" \
		"AGENT_FLOW_PORT=$port"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "agentflow"
}
